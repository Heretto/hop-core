# hop-core demo — copy this file to .env and fill in secrets
# Run `make setup` from the demo/ directory to generate secrets automatically.

APP_ENV=development
APP_DEBUG=true

DATABASE_URL=sqlite:///./demo.db
REDIS_URL=redis://localhost:6379

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=CHANGE_ME

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME

# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME

FRONTEND_BASE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# ── Single sign-on ───────────────────────────────────────────────────────────
# SSO_ONLY is the preferred way to run an app in production: the identity
# provider becomes the only way in, and password sign-up, login, reset and
# password-based invitation acceptance are all refused. It is left off here so
# the demo runs locally without a provider. See AGENTS.md §11 before enabling.
#
# Configure at least one provider below, or nobody can sign in. Existing
# password users keep their account by signing in through SSO with the same
# email, so check every administrator has an identity at the provider first.
#SSO_ONLY=true

# Google: the OAuth client's "Authorized JavaScript origins" must include the
# frontend origin (e.g. https://app.example.com). No client secret is needed.
#GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Microsoft (Entra ID): register the redirect URI
#   {OAUTH_REDIRECT_BASE_URL}/api/v1/auth/sso/microsoft/callback
# Set your own tenant ID: the default, "common", accepts any Microsoft account.
#MICROSOFT_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
#MICROSOFT_OAUTH_CLIENT_SECRET=
#MICROSOFT_OAUTH_TENANT_ID=00000000-0000-0000-0000-000000000000

# Public URL of the app, used for the Microsoft redirect. Defaults to the first
# CORS_ORIGINS entry.
#OAUTH_REDIRECT_BASE_URL=https://app.example.com

# Optional: limit which email domains can sign in for the first time.
#ALLOWED_EMAIL_DOMAINS=example.com

# Optional: put every new user in one existing organization instead of creating
# one per user. The organization with this slug must already exist.
#SINGLE_ORG_MODE=true
#SINGLE_ORG_SLUG=acme
